{
  "info": {
    "name": "Metadata Service",
    "description": "Casos de teste para autenticacao JWT, CRUD de Metadata e consulta de historico.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "metadataId",
      "value": ""
    },
    {
      "key": "username",
      "value": "postman_user"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Create user - 201",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"postman-password-123\"\n}"
            },
            "url": "{{baseUrl}}/auth/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or user already exists', function () { pm.expect([201, 409]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - 200",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"postman-password-123\"\n}"
            },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with invalid credentials - 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/auth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check - 200",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service is healthy', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Metadata CRUD",
      "item": [
        {
          "name": "Create metadata version - 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Changed-By", "value": "postman" }
            ],
            "body": {
              "mode": "raw",
                "raw": "{\n  \"dataset_id\": \"fintech_core.fact_transacoes_pix_v1\",\n  \"table_name\": \"fact_transacoes_pix\",\n  \"description\": \"Tabela fato incremental contendo todas as transações PIX liquidadas e com falha.\",\n  \"domain\": \"Payment Processing\",\n  \"owner\": \"squad-payments-data\",\n  \"storage\": {\n    \"provider\": \"aws_s3\",\n    \"format\": \"iceberg\",\n    \"storage_path\": \"s3://prod-fintech-data-lakehouse/payments/fact_transacoes_pix/\",\n    \"is_partitioned\": true,\n    \"partition_keys\": [\"data_transacao\", \"status_transacao\"],\n    \"clustering_keys\": [\"id_conta_origem\"]\n  },\n  \"governance\": {\n    \"data_classification\": \"confidencial_pii\",\n    \"pci_dss_scope\": false,\n    \"lgpd_sensitive_data\": true,\n    \"data_retention_days\": 1825,\n    \"encryption\": \"KMS_CUSTOMER_MANAGED_KEY\"\n  },\n  \"current_version\": 4,\n  \"current_schema\": [\n    {\n      \"field\": \"id_transacao_end_to_end\",\n      \"type\": \"STRING\",\n      \"nullable\": false,\n      \"description\": \"ID EndToEnd do BACEN (Identificador único da transação PIX).\",\n      \"is_primary_key\": true,\n      \"pii_type\": null\n    },\n    {\n      \"field\": \"dt_hr_transacao\",\n      \"type\": \"TIMESTAMP\",\n      \"nullable\": false,\n      \"description\": \"Carimbo de data/hora UTC do processamento da transação.\",\n      \"is_primary_key\": false,\n      \"pii_type\": null\n    },\n    {\n      \"field\": \"id_conta_origem\",\n      \"type\": \"STRING\",\n      \"nullable\": false,\n      \"description\": \"UUID da conta do pagador.\",\n      \"is_primary_key\": false,\n      \"pii_type\": \"ACCOUNT_ID\"\n    },\n    {\n      \"field\": \"cpf_cnpj_destino\",\n      \"type\": \"STRING\",\n      \"nullable\": false,\n      \"description\": \"Documento do recebedor (MASCARADO em ambientes não-produtivos).\",\n      \"is_primary_key\": false,\n      \"pii_type\": \"CPF_CNPJ\"\n    },\n    {\n      \"field\": \"valor_transacao\",\n      \"type\": \"DECIMAL(18,2)\",\n      \"nullable\": false,\n      \"description\": \"Valor nominal da transação em BRL com 2 casas decimais.\",\n      \"is_primary_key\": false,\n      \"pii_type\": null\n    },\n    {\n      \"field\": \"status_transacao\",\n      \"type\": \"STRING\",\n      \"nullable\": false,\n      \"description\": \"Estado final: LIQUIDADO, REJEITADO, CANCELADO, EM_ANALISE_FRAUDE.\",\n      \"is_primary_key\": false,\n      \"pii_type\": null\n    }\n  ],\n  \"lineage\": {\n    \"upstream_sources\": [\n      \"kafka://prod-cluster/topics/pix-settlement-events\",\n      \"s3://raw-landzone/bacen/pix_responses/\"\n    ],\n    \"pipeline_job_id\": \"airflow_dag_pix_facts_daily_v2\"\n  },\n  \"created_at\": \"2024-03-15T08:00:00Z\",\n  \"updated_at\": \"2026-09-23T09:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/metadata?change_type=INITIAL_CREATION&details=Created%20from%20Postman"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Response contains an id', function () { pm.expect(body.id).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('metadataId', body.id);",
                  "pm.test('Metadata table is correct', function () { pm.expect(body.table_name).to.eql('fact_transacoes_pix'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List metadata - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metadata"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get metadata by id - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metadata/{{metadataId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returned id matches requested id', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('metadataId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update metadata - 200",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"platform\",\n  \"description\": \"Dados atualizados\"\n}"
            },
            "url": "{{baseUrl}}/metadata/{{metadataId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Owner was updated', function () { pm.expect(pm.response.json().owner).to.eql('platform'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get metadata histories - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metadata/{{metadataId}}/histories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete metadata - 204",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/metadata/{{metadataId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Metadata without token - 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metadata"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Authentication error is standardized', function () { pm.expect(pm.response.json().error.code).to.eql('http_error'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create metadata with invalid payload - 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_name\": \"\",\n  \"current_version\": \"invalid\"\n}"
            },
            "url": "{{baseUrl}}/metadata"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', function () { pm.response.to.have.status(422); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get unknown metadata - 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/metadata/000000000000000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update unknown metadata - 404",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"finance\"\n}"
            },
            "url": "{{baseUrl}}/metadata/000000000000000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete unknown metadata - 404",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/metadata/000000000000000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
