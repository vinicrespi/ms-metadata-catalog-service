{
  "info": {
    "name": "Metadata Catalog Service",
    "description": "Casos de teste para os endpoints da API de catalogo de metadados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "metadataId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Service is healthy', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Metadata CRUD",
      "item": [
        {
          "name": "Create metadata - 201",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
                "raw": "{\n  \"name\": \"payments\",\n  \"description\": \"Payment table\",\n  \"owner\": \"finance\",\n  \"source_system\": \"postgres\",\n  \"metadata\": {\n    \"columns\": [\"id\", \"customer_id\", \"amount\"]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/metadata",
              "host": ["{{baseUrl}}"],
              "path": ["metadata"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response contains an id', function () {",
                  "    pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('metadataId', body.id);",
                  "pm.test('Metadata was persisted', function () {",
                  "    pm.expect(body.metadata.columns).to.include('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List metadata - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metadata",
              "host": ["{{baseUrl}}"],
              "path": ["metadata"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get metadata by id - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metadata/{{metadataId}}",
              "host": ["{{baseUrl}}"],
              "path": ["metadata", "{{metadataId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returned id matches requested id', function () {",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('metadataId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update metadata - 200",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"platform\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/metadata/{{metadataId}}",
              "host": ["{{baseUrl}}"],
              "path": ["metadata", "{{metadataId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Owner was updated', function () {",
                  "    pm.expect(pm.response.json().owner).to.eql('platform');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete metadata - 204",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metadata/{{metadataId}}",
              "host": ["{{baseUrl}}"],
              "path": ["metadata", "{{metadataId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Create metadata with invalid payload - 422",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"Payment table\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/metadata",
              "host": ["{{baseUrl}}"],
              "path": ["metadata"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get unknown metadata - 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metadata/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["metadata", "000000000000000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update unknown metadata - 404",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": \"finance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/metadata/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["metadata", "000000000000000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete unknown metadata - 404",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metadata/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["metadata", "000000000000000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
